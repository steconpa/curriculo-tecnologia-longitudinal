{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lista de proyectos",
  "description": "Estructura para un archivo de mapping de proyectos (lista). v1.1.0 endurece los enums de modalidad, nivel_complejidad, producto y portafolio_evidencias para que coincidan con la taxonomia controlada en taxonomy/categorias.json.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "version": { "type": "string" },
    "fecha_actualizacion": { "type": "string" },
    "descripcion": { "type": "string" },
    "grado_rango": { "type": "string" },
    "proyectos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "grado_aplicable",
          "evidencias_men",
          "macrocompetencias"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^P(6|7|8|9|10|11)-[0-9]{2}$" },
          "nombre": { "type": "string", "minLength": 4, "maxLength": 80 },
          "grado_aplicable": { "type": "integer", "minimum": 6, "maximum": 11 },
          "duracion_semanas": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "producto": {
            "type": "string",
            "enum": [
              "infografia",
              "videojuego",
              "simulacion",
              "sitio_web",
              "automatizacion",
              "campana_digital",
              "animacion_interactiva",
              "prototipo_arduino",
              "prototipo_fisico",
              "presentacion_digital",
              "video_documental",
              "documento_tecnico"
            ]
          },
          "modalidad": {
            "type": "string",
            "enum": ["individual", "grupal", "mixta"]
          },
          "nivel_complejidad": {
            "type": "string",
            "enum": ["basico", "intermedio", "avanzado"]
          },
          "evidencias_men": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(NETI|UATI|SPTI|TIS)-[0-9]+-[0-9]+-[0-9]{2}$"
            }
          },
          "macrocompetencias": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^MC-[A-Z0-9]+$" }
          },
          "portafolio_evidencias": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "capturas_pantalla",
                "reflexion_corta",
                "autoevaluacion",
                "plan_trabajo",
                "versionado",
                "reflexion_equipo",
                "capturas_diagramas",
                "explicacion_pasos",
                "video_corto",
                "bitacora",
                "diagrama_ramas",
                "capturas_eventos",
                "reflexion_mejoras",
                "plan_alpha",
                "pruebas",
                "capturas_bugs",
                "rol_tareas",
                "repositorio_compartido",
                "retrospectiva",
                "propuesta_inicial",
                "prototipo_iterativo",
                "video_explicativo",
                "capturas_codigo",
                "mapa_conceptual",
                "plan_diseno",
                "foto_prototipo",
                "tabla_comparativa",
                "guion_video",
                "acta_debate",
                "diseno_circuito",
                "informe_experimentacion"
              ]
            }
          },
          "descripcion_pedagogica": { "type": "string" },
          "justificacion_cobertura": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["version", "schema_version", "fecha_actualizacion", "proyectos"]
}
