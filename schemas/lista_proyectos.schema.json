{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lista de proyectos",
  "description": "Estructura para un archivo de mapping de proyectos (lista)",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "version": { "type": "string" },
    "fecha_actualizacion": { "type": "string" },
    "descripcion": { "type": "string" },
    "grado_rango": { "type": "string" },
    "proyectos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "grado_aplicable",
          "evidencias_men",
          "macrocompetencias"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^P(6|7|8|9|10|11)-[0-9]{2}$" },
          "nombre": { "type": "string" },
          "grado_aplicable": { "type": "integer", "minimum": 6, "maximum": 11 },
          "duracion_semanas": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "producto": { "type": "string" },
          "modalidad": { "type": "string" },
          "nivel_complejidad": { "type": "string" },
          "evidencias_men": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{4}-[0-9]+-[0-9]+-[0-9]{2}$"
            }
          },
          "macrocompetencias": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MC-[A-Z0-9]+$" }
          },
          "portafolio_evidencias": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["version", "schema_version", "fecha_actualizacion", "proyectos"]
}
